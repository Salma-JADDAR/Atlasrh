<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-leave-requests" author="salma">

        <createTable tableName="leave_requests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_leave_requests"
                             nullable="false"/>
            </column>

            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="end_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>

            <column name="working_days" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>

            <column name="manager_comment" type="VARCHAR(500)"/>

            <column name="employee_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="leave_type_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="leave_requests"
                baseColumnNames="employee_id"
                constraintName="fk_leave_requests_employee"
                referencedTableName="employees"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="leave_requests"
                baseColumnNames="leave_type_id"
                constraintName="fk_leave_requests_leave_type"
                referencedTableName="leave_types"
                referencedColumnNames="id"/>

    </changeSet>

</databaseChangeLog>
